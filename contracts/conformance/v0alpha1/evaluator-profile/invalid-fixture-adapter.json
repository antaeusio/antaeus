{
  "apiVersion": "evaluator.antaeus.io/v0alpha1",
  "kind": "EvaluatorProfile",
  "metadata": {"name": "fixture-adapter"},
  "spec": {
    "totalTimeoutMs": 2000,
    "credentialSlots": [],
    "evaluators": [
      {
        "id": "fake-fixture",
        "mode": "deterministic-fixture",
        "adapter": {"id": "io.example.semantic", "version": "1"},
        "protocol": {"id": "io.antaeus.rule-match", "version": "v0alpha1"},
        "requiredCapabilities": ["json-input"],
        "timeoutMs": 1000,
        "retry": {"maxAttempts": 1, "retryOn": []},
        "parameters": {"endpoint": "https://internal.invalid"}
      }
    ],
    "routing": {
      "primary": "fake-fixture",
      "fallbacks": [],
      "confidence": {"enabled": false},
      "terminal": {"onIndeterminate": "failure", "onFailure": "failure"}
    }
  }
}
