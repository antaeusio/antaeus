{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antaeus.io/contracts/v0alpha1/local-secret-bindings.schema.json",
  "title": "Antaeus LocalSecretBindings v0alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "secretBindings"],
  "properties": {
    "apiVersion": {
      "const": "config.antaeus.io/v0alpha1"
    },
    "kind": {
      "const": "LocalSecretBindings"
    },
    "secretBindings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/namespacedId"
          },
          {
            "not": {
              "const": "io.antaeus.fixture"
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 16,
        "propertyNames": {
          "$ref": "#/$defs/localId"
        },
        "additionalProperties": {
          "$ref": "#/$defs/secretReference"
        }
      }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
      "maxLength": 128
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "secretReference": {
      "type": "object",
      "required": ["source", "name"],
      "properties": {
        "source": {
          "const": "environment"
        },
        "name": {
          "$ref": "#/$defs/environmentName"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
