{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antaeus.io/contracts/v0alpha1/common.schema.json",
  "title": "Antaeus v0alpha1 shared definitions",
  "$defs": {
    "policyOutcome": {
      "type": "string",
      "enum": ["allow", "review", "deny"]
    },
    "decisionOutcome": {
      "type": "string",
      "enum": ["allow", "review", "deny", "failure"]
    },
    "ruleStatus": {
      "type": "string",
      "enum": ["matched", "not_matched", "indeterminate", "failed"]
    },
    "policyName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reasonCode"
      }
    },
    "policyIdentity": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "$ref": "#/$defs/policyName"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "unevaluatedProperties": false
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
      },
      "additionalProperties": true
    }
  }
}
