{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antaeus.io/contracts/v0alpha1/fixture-set.schema.json",
  "title": "Antaeus deterministic FixtureSet v0alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "cases"],
  "properties": {
    "apiVersion": {
      "const": "fixture.antaeus.io/v0alpha1"
    },
    "kind": {
      "const": "FixtureSet"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        }
      },
      "unevaluatedProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "policyName", "policyDigest", "inputDigest", "ruleResults"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "policyName": {
          "$ref": "common.schema.json#/$defs/policyName"
        },
        "policyDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "inputDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "ruleResults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/ruleResult"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "ruleResult": {
      "type": "object",
      "required": ["ruleId", "status", "reasonCodes"],
      "properties": {
        "ruleId": {
          "$ref": "common.schema.json#/$defs/ruleId"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/ruleStatus"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "$ref": "common.schema.json#/$defs/reasonCodes"
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
