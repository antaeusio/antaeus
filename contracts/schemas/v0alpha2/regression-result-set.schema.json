{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antaeus.io/contracts/v0alpha2/regression-result-set.schema.json",
  "title": "Antaeus RegressionResultSet v0alpha2",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "suite",
    "policy",
    "fixtureSet",
    "passed",
    "results"
  ],
  "properties": {
    "apiVersion": {
      "const": "regression.antaeus.io/v0alpha2"
    },
    "kind": {
      "const": "RegressionResultSet"
    },
    "suite": {
      "$ref": "../v0alpha1/regression-suite.schema.json#/$defs/versionedIdentity"
    },
    "policy": {
      "$ref": "../v0alpha1/common.schema.json#/$defs/policyIdentity"
    },
    "fixtureSet": {
      "$ref": "../v0alpha1/regression-suite.schema.json#/$defs/versionedIdentity"
    },
    "passed": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    }
  },
  "$defs": {
    "caseResult": {
      "type": "object",
      "required": [
        "name",
        "fixtureCase",
        "status",
        "expected",
        "decision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "fixtureCase": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "expected": {
          "$ref": "../v0alpha1/regression-suite.schema.json#/$defs/expectation"
        },
        "decision": {
          "$ref": "decision.schema.json"
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
