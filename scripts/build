#!/bin/sh

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
output=${ANTAEUS_OUTPUT:-$repo_root/.tmp/bin/antaeus}
version=${ANTAEUS_VERSION:-dev}
commit=${ANTAEUS_COMMIT:-}

case "$output" in
  /*) ;;
  *) output="$repo_root/$output" ;;
esac

case "$version" in
  ''|*[!A-Za-z0-9._+-]*)
    echo "build: ANTAEUS_VERSION contains unsupported characters" >&2
    exit 64
    ;;
esac

if [ -z "$commit" ]; then
  commit=$(git -C "$repo_root" rev-parse --short=12 HEAD 2>/dev/null || true)
  if [ -n "$(git -C "$repo_root" status --porcelain --untracked-files=normal 2>/dev/null || true)" ]; then
    commit="${commit:-unknown}-dirty"
  fi
fi
commit=${commit:-unknown}

case "$commit" in
  *[!A-Za-z0-9._+-]*)
    echo "build: ANTAEUS_COMMIT contains unsupported characters" >&2
    exit 64
    ;;
esac

mkdir -p "$(dirname -- "$output")"

ldflags="-X github.com/antaeusio/antaeus/internal/buildinfo.version=$version -X github.com/antaeusio/antaeus/internal/buildinfo.commit=$commit"

cd "$repo_root"
CGO_ENABLED=0 exec "$repo_root/scripts/with-build-lock" \
  go build -trimpath -ldflags "$ldflags" -o "$output" ./cmd/antaeus
