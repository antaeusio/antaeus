#!/bin/sh

set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)

unformatted=$(find "$repo_root" -type f -name '*.go' \
  -not -path "$repo_root/.git/*" \
  -not -path "$repo_root/.tmp/*" \
  -exec gofmt -l {} +)
if [ -n "$unformatted" ]; then
  echo "check: gofmt is required for:" >&2
  echo "$unformatted" >&2
  exit 1
fi

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "check: shellcheck is required" >&2
  exit 69
fi

# Analyze every shell script in scripts/ (the .mjs helper is JavaScript).
set --
for script in "$repo_root"/scripts/*; do
  case "$script" in
    *.mjs) ;;
    *) set -- "$@" "$script" ;;
  esac
done
shellcheck "$@"

# Uses temporary copies of the wrapper; never the repository lock. Also run
# the wrapper under dash when available, as Ubuntu's /bin/sh.
"$repo_root/scripts/test-build-lock"
if command -v dash >/dev/null 2>&1; then
  TEST_SHELL=dash dash "$repo_root/scripts/test-build-lock"
fi

# The single-quoted program intentionally expands $1 in the child shell.
# shellcheck disable=SC2016
exec "$repo_root/scripts/with-build-lock" sh -c '
  set -eu
  cd "$1"
  go vet ./...
  go test ./...
' sh "$repo_root"
