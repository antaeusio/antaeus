#!/bin/sh

# Build the release container locally for the host architecture and load it
# into Docker, for testing:
#   scripts/container-image v0.2.0-rc.0
# Publishing happens only in the tag-triggered release workflow.

set -eu

[ "$#" -eq 1 ] || { echo "usage: scripts/container-image VERSION" >&2; exit 64; }
version=$1
if ! printf '%s\n' "$version" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$'; then
  echo "container-image: version must look like v0.2.0 or v0.2.0-rc.0" >&2
  exit 64
fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)

if ! command -v docker >/dev/null 2>&1; then
  echo "container-image: docker is required" >&2
  exit 69
fi

# Hold the build lock for cross-compilation and the image build together.
if [ "${ANTAEUS_BUILD_LOCK_HELD:-}" != 1 ]; then
  exec "$repo_root/scripts/with-build-lock" "$0" "$@"
fi

if [ -n "$(git -C "$repo_root" status --porcelain --untracked-files=normal)" ]; then
  echo "container-image: working tree is not clean" >&2
  exit 65
fi
commit=$(git -C "$repo_root" rev-parse --short=12 HEAD)
revision=$(git -C "$repo_root" rev-parse HEAD)
ANTAEUS_VERSION=$version ANTAEUS_COMMIT=$commit "$repo_root/scripts/cross-build"
docker build --load --build-arg VERSION="$version" --build-arg REVISION="$revision" \
  --tag "antaeus:$version" "$repo_root"
echo "container-image: built antaeus:$version"
